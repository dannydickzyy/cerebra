# Copy this file to .env (ignored by git) and set your own values before the first run.
# These accounts are created only when the users table is empty.
# A missing password is replaced by a random one printed once in the server log.
CEREBRA_ADMIN_USERNAME=admin
CEREBRA_ADMIN_PASSWORD=
CEREBRA_ADMIN_NAME=Administrator
CEREBRA_WORKER_USERNAME=worker
CEREBRA_WORKER_PASSWORD=
CEREBRA_WORKER_NAME=Healthcare worker

# Optional
# CEREBRA_DB_PATH=data/cerebra.sqlite3
# CEREBRA_IDLE_SECONDS=1800
